{% extends 'base.html.twig' %}

{% block title %}RicagE.dev — Du métier au digital{% endblock %}

{% block body %}

<main>
<div class="section-transition" aria-hidden="true"></div>
    <section id="home" class="hero">

        <div class="hero-bg" aria-hidden="true">
            <span class="hero-bg__block hero-bg__block--1"></span>
            <span class="hero-bg__block hero-bg__block--2"></span>
            <span class="hero-bg__block hero-bg__block--3"></span>
            
        </div>

        <div class="hero-logo">
            {% include 'components/logo_ricage.html.twig' %}
            <span class="dev">.dev</span>
        </div>

        <div class="hero-content">
            <h1>Du métier au digital.</h1>

            <p>
                Je conçois des sites web qui marquent
                et des outils numériques pensés pour le terrain.
            </p>
        </div>

        <nav class="hero-nav">
        <a href="#projets">PROJETS</a>
        <a href="#profile">PROFIL</a>
        <a href="#contact">CONTACT</a>
    </nav>

    </section>

    <section id="projets" class="projects">


    <h2>PROJETS</h2>

    <article class="project-card">

    <div class="project-info">
        <span class="project-number">#01</span>

        <h3>HUMAIN</h3>

        <p class="project-type">
            Site artiste · Direction artistique · Développement
        </p>

        <p class="project-stack">
            Symfony · Twig · GSAP
        </p>

        <a href="#" class="project-link">
            Voir le projet →
        </a>
    </div>

    <div class="project-visual">
        <img
    src="{{ asset('images/projets/Mask.jpg') }}"
    alt="Aperçu du site HUMAIN"
    class="project-card__image"
>
    </div>

</article>
</section>

<section id="profile" class="profile">
    <h2>PROFIL</h2>
</section>

<section id="contact" class="contact">
    <h2>CONTACT</h2>
</section>

    
</main>



{% endblock %}