<section id="contact" class="contact">

    <div class="section-heading">
    <h2>CONTACT</h2>

   
</div>

{% for message in app.flashes('contact_success') %}
    <p class="contact-form__success" role="status">
        {{ message }}
    </p>
{% endfor %}

  <div class="contact-content">
    <button
    type="button"
    class="contact-scatter"
    aria-expanded="{{ contactErrors|default([]) ? 'true' : 'false' }}"
{% if contactErrors|default([]) %}hidden{% endif %}
    aria-controls="contact-form-panel"
    aria-label="Afficher le formulaire de contact"
>
        <span class="contact-scatter__line" aria-hidden="true">
            <span style="--x: -5vw; --y: -3rem; --r: -8deg">Un</span>
            <span style="--x: -2vw; --y: 2rem; --r: 6deg">pro</span><span
                style="--x: 2vw; --y: -1rem; --r: -5deg"
            >jet</span>
            <span style="--x: 5vw; --y: 3rem; --r: 7deg">en tête ?</span>
        </span>

        <span class="contact-scatter__line contact-scatter__line--accent"
              aria-hidden="true">
            <span style="--x: -7vw; --y: 1rem; --r: -6deg">Par</span><span
                style="--x: 1vw; --y: -2rem; --r: 8deg"
            >lons</span><span
                style="--x: 6vw; --y: 2rem; --r: -5deg"
            >-en.</span>
        </span>

        <span class="contact-scatter__line contact-scatter__line--email"
              aria-hidden="true">
            <span style="--x: -6vw; --y: 2rem; --r: 5deg">ric</span><span
                style="--x: -3vw; --y: -1rem; --r: -8deg"
            >age</span><span
                style="--x: 0vw; --y: 3rem; --r: 6deg"
            >.dev</span><span
                style="--x: 3vw; --y: -2rem; --r: -7deg"
            >@</span><span
                style="--x: 5vw; --y: 1rem; --r: 5deg"
            >gmail</span><span
                style="--x: 7vw; --y: 3rem; --r: -6deg"
            >.com</span>
        </span>
    </button>

   <div
    id="contact-form-panel"
    class="contact-form-panel"
    {% if not contactErrors|default([]) %}hidden{% endif %}
>
    {% if contactErrors|default([]) %}
        <div class="contact-form__errors" role="alert">
            {% for error in contactErrors %}
                <p>{{ error }}</p>
            {% endfor %}
        </div>
    {% endif %}

    <form
        class="contact-form"
        action="{{ path('app_home') }}#contact"
        method="post"
        data-turbo="false"
    >
        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('contact') }}"
        >

        <div class="contact-form__field">
            <label for="contact-name">Nom *</label>
            <input
                type="text"
                id="contact-name"
                name="name"
                value="{{ contactValues.name|default('') }}"
                autocomplete="name"
                maxlength="150"
                required
            >
        </div>

        <div class="contact-form__field">
            <label for="contact-email">E-mail *</label>
            <input
                type="email"
                id="contact-email"
                name="email"
                value="{{ contactValues.email|default('') }}"
                autocomplete="email"
                maxlength="254"
                required
            >
        </div>

        <div class="contact-form__field">
            <label for="contact-company">Entreprise</label>
            <input
                type="text"
                id="contact-company"
                name="company"
                value="{{ contactValues.company|default('') }}"
                autocomplete="organization"
                maxlength="150"
            >
        </div>

        <div class="contact-form__field">
            <label for="contact-phone">Téléphone</label>
            <input
                type="tel"
                id="contact-phone"
                name="phone"
                value="{{ contactValues.phone|default('') }}"
                autocomplete="tel"
                maxlength="40"
            >
        </div>

        <div class="contact-form__field contact-form__field--full">
            <label for="contact-message">Votre projet *</label>
            <textarea
                id="contact-message"
                name="message"
                rows="4"
                maxlength="10000"
                required
            >{{ contactValues.message|default('') }}</textarea>
        </div>

                       <div class="contact-form__actions">
                    <small>* Champs obligatoires.</small>

                    <button type="button" class="contact-form-back">
                        ANNULER
                    </button>

                    <button type="submit">
                        ENVOYER LE MESSAGE ↗
                    </button>
                </div>
            </form>
        </div>
    </div>

    {% include 'components/footer.html.twig' %}
</section>



{# Lightbox commune à tous les projets #}
<div
    id="project-lightbox"
    class="project-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Agrandissement d'une capture de projet"
    hidden
>
    <button
        type="button"
        class="project-lightbox__close"
        aria-label="Fermer l'image"
    >
        &times;
    </button>

    <img
        class="project-lightbox__image"
        src=""
        alt=""
    >
</div>
    
</main>



