{% extends 'base.html.twig' %}

{% block title %}RicagE.dev — Du métier au digital{% endblock %}

{% block body %}
 <div class="hero-bg" aria-hidden="true">
        <span class="hero-bg__block hero-bg__block--1"></span>
        <span class="hero-bg__block hero-bg__block--2"></span>
        <span class="hero-bg__block hero-bg__block--3"></span>
    </div>

   {# Navigation mobile RicAgE #}
<button
    class="mobile-menu-toggle"
    type="button"
    aria-label="Ouvrir le menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
>
    <span></span>
    <span></span>
    <span></span>
</button>
    
 <nav class="hero-nav">
        <a href="#home">ACCUEIL</a>
        <a href="#projets">PROJETS</a>
        <a href="#profile">PROFIL</a>
        <a href="#contact">CONTACT</a>
    </nav>   
<nav id="mobile-menu" class="mobile-menu" aria-label="Navigation mobile" inert>
    <a href="#home">ACCUEIL</a>
    <a href="#projets">PROJETS</a>
    <a href="#profile">PROFIL</a>
    <a href="#contact">CONTACT</a>
</nav>

   <main>

    <section id="home" class="hero">

        <div class="hero-logo">
            {% include 'components/logo_ricage.html.twig' %}
            <span class="dev">.dev</span>
        </div>

        <div class="hero-content">
            <h1>Du métier au digital.</h1>

            <p>
                Je conçois des sites web qui marquent
                et des outils numériques pensés pour le terrain.
            </p>
        </div>

        

    </section>

    <section id="projets" class="projects">

    <div class="section-heading">

    <h2>PROJETS</h2>

  

</div>

    {# Données du projet HUMAIN #}
    {% set projects = [
        {
            number: '#01',
            slug: 'humain',
            title: 'HUMAIN',
            description: 'Site artistique immersif & administration sur mesure.',
            stack: 'Symfony · Twig · GSAP · EasyAdmin',
            image: 'images/projets/humain-photos/Mask.jpg',
            imageAlt: 'Aperçu du site HUMAIN',

            images: [
    'images/projets/humain-photos/Mask.jpg',
    'images/projets/humain-photos/humain-admin.png',
    'images/projets/humain-photos/humain-bio.png',
    'images/projets/humain-photos/humain-contact.png',
    'images/projets/humain-photos/humain-musique.png',
    'images/projets/humain-photos/humain-photo.png',
],

            intro: 'Création d’un site artistique immersif associant design sur mesure, animations GSAP et contenus multimédias.',

            features: 'Une administration sécurisée permet à l’artiste de gérer ses photos, musiques, vidéos, événements, demandes de booking et communications par e-mail, ainsi que ses newsletters, en toute autonomie.',

            adminImage: 'images/projets/humain-photos/humain-admin.png'
        }
    ] %}

    {# Affichage automatique des projets #}
    {% for project in projects %}

        {% include 'components/project-card.html.twig' with {
            project: project
        } only %}

       

    {% endfor %}

</section>

<section id="profile" class="profile">   
    

    <div class="section-heading">
    <h2>PROFIL</h2>

    
</div>

     {# =====================================
       PHOTO + PRÉSENTATION
    ===================================== #}



<div class="profile-content">

    <div class="profile-intro">

        <h3>Du terrain au numérique.</h3>

        <p>
            Développeur web orienté <strong>front-end</strong>,
            je conçois et développe des sites internet modernes,
            accessibles et adaptés aux besoins de chaque projet.
        </p>

        <p>
            Du site vitrine simple à l'expérience web interactive,
            j'accorde une attention particulière au
            <strong>design</strong>, à la fluidité et à
            <strong>l'expérience utilisateur</strong>.
        </p>

        <p>
            Fort de mon expérience dans les métiers techniques,
            je comprends les réalités du terrain et les besoins
            concrets des artisans, indépendants et petites entreprises.
        </p>

    </div>

    <div class="profile-photo">
        <img
            src="{{ asset('images/ricage-covert.png') }}"
            alt="Portrait de profil du développeur RicAgE"
            loading="lazy"
        >
    </div>

    <div class="profile-skills">

    <h3>SKILLS & STACK</h3>

    <div class="profile-skills__grid">

        <div class="profile-skills__item">
            <h4>FRONT-END</h4>
            <p>HTML5 / CSS3 / SCSS</p>
            <p>JavaScript</p>
            <p>Twig</p>
        </div>

        <div class="profile-skills__item">
            <h4>BACK-END</h4>
            <p>PHP / Symfony</p>
            <p>MySQL</p>
            
        </div>

        <div class="profile-skills__item">
            <h4>DESIGN & ANIMATION</h4>
            <p>UI / UX Design</p>
            <p>Figma / Penpot</p>
            <p>GSAP / ScrollTrigger</p>
        </div>

        <div class="profile-skills__item">
            <h4>OUTILS</h4>
            <p>Git / GitHub</p>
            <p>VS Code</p>
            <p>Responsive Design</p>
        </div>

    </div>

</div>
</div>

         </div>

    

    {# =====================================
       MES SERVICES
    ===================================== #}

    <div class="profile-services">

        <h3>MES SERVICES</h3>

        <div class="profile-services__grid">

            <div class="profile-services__item">
                <h4>CRÉATION DE SITES WEB</h4>

                <p>Sites vitrines</p>
                <p>Sites professionnels sur mesure</p>
                <p>Design responsive</p>
                <p>Animations et interactions</p>
                <p>Référencement naturel (SEO)</p>
            </div>

            <div class="profile-services__item">
                <h4>APPLICATIONS & OUTILS MÉTIER</h4>

                <p>Applications web sur mesure</p>
                <p>Gestion de clients</p>
                <p>Devis et facturation</p>
                <p>Tableaux de bord</p>
                <p>Automatisation de tâches</p>
            </div>

        </div>

    </div>

    

</div>

   

        

    </div>

</section>

