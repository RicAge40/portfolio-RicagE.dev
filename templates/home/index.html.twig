{% extends 'base.html.twig' %}

{% block title %}RicagE.dev — Du métier au digital{% endblock %}

{% block body %}

<main>
<div class="section-transition" aria-hidden="true"></div>
    <section id="home" class="hero">

        <div class="hero-bg" aria-hidden="true">
            <span class="hero-bg__block hero-bg__block--1"></span>
            <span class="hero-bg__block hero-bg__block--2"></span>
            <span class="hero-bg__block hero-bg__block--3"></span>
            
        </div>

        <div class="hero-logo">
            {% include 'components/logo_ricage.html.twig' %}
            <span class="dev">.dev</span>
        </div>

        <div class="hero-content">
            <h1>Du métier au digital.</h1>

            <p>
                Je conçois des sites web qui marquent
                et des outils numériques pensés pour le terrain.
            </p>
        </div>

        <nav class="hero-nav">
        <a href="#projets">PROJETS</a>
        <a href="#profile">PROFIL</a>
        <a href="#contact">CONTACT</a>
    </nav>

    </section>

    <section id="projets" class="projects">

    <h2>PROJETS</h2>

    {# Données du projet HUMAIN #}
    {% set projects = [
        {
            number: '#01',
            slug: 'humain',
            title: 'HUMAIN',
            description: 'Site artistique immersif & administration sur mesure.',
            stack: 'Symfony · Twig · GSAP · EasyAdmin',
            image: 'images/projets/Mask.jpg',
            imageAlt: 'Aperçu du site HUMAIN',

            images: [
    'images/projets/Mask.jpg',
    'images/projets/humain-admin.png'
],

            intro: 'Création d’un site artistique immersif associant design sur mesure, animations GSAP et contenus multimédias.',

            features: 'Une administration sécurisée permet à l’artiste de gérer ses photos, musiques, vidéos, événements, demandes de booking et communications par e-mail, ainsi que ses newsletters, en toute autonomie.',

            adminImage: 'images/projets/humain-admin.png'
        }
    ] %}

    {# Affichage automatique des projets #}
    {% for project in projects %}

        {% include 'components/project-card.html.twig' with {
            project: project
        } only %}

       

    {% endfor %}

</section>

<section id="profile" class="profile">
    <h2>PROFIL</h2>
</section>

<section id="contact" class="contact">
    <h2>CONTACT</h2>
</section>

{# Lightbox commune à tous les projets #}
<div
    id="project-lightbox"
    class="project-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Agrandissement d'une capture de projet"
    hidden
>
    <button
        type="button"
        class="project-lightbox__close"
        aria-label="Fermer l'image"
    >
        &times;
    </button>

    <img
        class="project-lightbox__image"
        src=""
        alt=""
    >
</div>
    
</main>



{% endblock %}